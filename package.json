{
  "name": "affiliate-geo-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "node scripts/build-cloudflare.mjs",
    "build:next": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "build:cloudflare": "npm run build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "npm run generate:types:cloudflare && npm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrations:sync": "tsx scripts/export-d1-migrations.ts",
    "daily:update": "tsx scripts/daily-update.ts",
    "daily:update:remote": "cross-env NODE_ENV=production tsx scripts/daily-update.ts",
    "daily:publish": "tsx scripts/daily-publish-ai.ts",
    "daily:enrich-products": "tsx scripts/daily-enrich-products.ts",
    "daily:catalog-sync": "tsx scripts/sync-digistore24-marketplace.ts",
    "daily:publish:remote": "cross-env NODE_ENV=production tsx scripts/daily-publish-ai.ts",
    "daily:verify": "tsx scripts/verify-daily-publish.ts",
    "daily:verify:remote": "cross-env NODE_ENV=production tsx scripts/verify-daily-publish.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:remote": "cross-env NODE_ENV=production tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "deploy": "npm run deploy:app && npm run deploy:database",
    "deploy:app": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "deploy:database": "npm run migrations:sync && wrangler d1 migrations apply D1 --remote && wrangler d1 execute D1 --command \"PRAGMA optimize\" --remote",
    "prepare:local-d1": "npm run migrations:sync && wrangler d1 migrations apply D1 --local",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=6144 eslint .",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@payloadcms/db-d1-sqlite": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/plugin-seo": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-r2": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.90.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
