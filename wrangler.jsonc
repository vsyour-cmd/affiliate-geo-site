{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "affiliate-geo-site",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "store.2bkf.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "5563a6ce-abc6-4ae7-a2ca-1ce9a399fc52",
      "database_name": "affiliate-geo-site",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "affiliate-geo-site-media"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
